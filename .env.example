# =============================================================================
# ALBERTH NEXUS — Plantilla de Configuración de Variables de Entorno (.env)
# Ubicación activa: ~/.openclaw/.env (chmod 600)
# =============================================================================

# ── Rutas y Espacio de Trabajo ───────────────────────────────────────────────
OPENCLAW_WORKSPACE=/Users/contabilidad/.gemini/antigravity-ide/scratch/Alberth
ALBERTH_WORKSPACE=/Users/contabilidad/.gemini/antigravity-ide/scratch/Alberth

# ── Seguridad y Control de Acceso ────────────────────────────────────────────
# Token opcional para autenticar llamadas REST y WebSockets al Panel Web
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_PORT=18789

# ── Proveedores de Modelos de Inteligencia Artificial ────────────────────────
# Groq (Transcripción STT ultra-rápida con Whisper Large Turbo)
GROQ_API_KEY=

# Nvidia NIM (Inferencia de Texto con GLM-5.1 y Qwen2.5-Coder-32B)
NVIDIA_API_KEY=

# Google Gemini / OpenRouter (Visión Multimodal, Copiloto de Pantalla y Reconocimiento)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Modos de Operación y Supervisión ──────────────────────────────────────────
# Modo de contexto predeterminado: laboral | personal
CONTEXT_MODE=laboral

# Modo No Molestar automático (true/false)
AUTO_DND=false
