# ======================= CACHE =======================
class TTLCache:
    """Simple thread‑safe TTL cache with LRU eviction when maxsize is reached."""
    def __init__(self, ttl_seconds: int = 300, maxsize: int = 100):
        self.ttl = ttl_seconds
        self.maxsize = maxsize
        self._cache: Dict[str, Any] = {}
        self._ts: Dict[str, float] = {}
        self._lock = threading.RLock()

    def get(self, key: str) -> Optional[Any]:
        with self._lock:
            if key in self._cache:
                if time.time() - self._ts[key] < self.ttl:
                    self._ts[key] = time.time()  # renew on hit
                    return self._cache[key]
                # expired
                del self._cache[key]
                del self._ts[key]
            return None

    def set(self, key: str, value: Any) -> None:
        with self._lock:
            if len(self._cache) >= self.maxsize:
                # evict oldest (simple LRU)
                oldest = min(self._ts, key=self._ts.get)
                del self._cache[oldest]
                del self._ts[oldest]
            self._cache[key] = value
            self._ts[key] = time.time()

    def stats(self) -> Dict[str, int]:
        with self._lock:
            return {"size": len(self._cache), "maxsize": self.maxsize}


# ======================= METRICS =======================
class Metrics:
    """Collects counters and latencies, exportable in Prometheus format."""
    def __init__(self):
        self._lock = threading.Lock()
        self._counters: Dict[str, int] = {}
        self._latency_sums: Dict[str, float] = {}
        self._latency_counts: Dict[str, int] = {}

    def inc(self, name: str, value: int = 1) -> None:
        with self._lock:
            self._counters[name] = self._counters.get(name, 0) + value

    def add_latency(self, name: str, seconds: float) -> None:
        with self._lock:
            self._latency_sums[name] = self._latency_sums.get(name, 0.0) + seconds
            self._latency_counts[name] = self._latency_counts.get(name, 0) + 1

    def snapshot(self) -> Dict[str, Any]:
        with self._lock:
            latencies = {}
            for name in self._latency_sums:
                cnt = self._latency_counts.get(name, 0)
                avg = self._latency_sums[name] / cnt if cnt else 0.0
                latencies[name] = avg
            return {
                "counters": dict(self._counters),
                "latency_avg": latencies,
                "latency_count": dict(self._latency_counts),
            }

    def to_prometheus(self) -> str:
        lines = []
        with self._lock:
            for name, val in self._counters.items():
                lines.append(f"# HELP alberth_{name} Counter")
                lines.append(f"# TYPE alberth_{name} counter")
                lines.append(f"alberth_{name} {val}")
            for name, total in self._latency_sums.items():
                cnt = self._latency_counts.get(name, 0)
                avg = total / cnt if cnt else 0.0
                lines.append(f"# HELP alberth_{name}_seconds Average latency of {name}")
                lines.append(f"# TYPE alberth_{name}_seconds gauge")
                lines.append(f"alberth_{name}_seconds {avg}")
                lines.append(f"# HELP alberth_{name}_count Count of {name}")
                lines.append(f"# TYPE alberth_{name}_count counter")
                lines.append(f"alberth_{name}_count {cnt}")
        return "\n".join(lines) + "\n"


# Global instances
metrics = Metrics()
query_cache = TTLCache(ttl_seconds=180, maxsize=500)  # 3 min TTL, 500 entries


# ======================= CIRCUIT BREAKER =======================
class CircuitState(Enum):
    CLOSED = "closed"
    OPEN = "open"
    HALF_OPEN = "half_open"


@dataclass
class CircuitBreakerConfig:
    failure_threshold: int = 5
    recovery_timeout: int = 30
    expected_exception: type = Exception
    success_threshold: int = 3
    timeout: float = 30.0


@dataclass
class CircuitBreakerStats:
    failure_count: int = 0
    success_count: int = 0
    last_failure_time: Optional[float] = None
    last_state_change: float = field(default_factory=time.time)
    total_calls: int = 0
    successful_calls: int = 0
    failed_calls: int = 0
    timeouts: int = 0


class CircuitBreakerOpenException(Exception):
    pass


class CircuitBreaker:
    def __init__(self, name: str, config: CircuitBreakerConfig = None):
        self.name = name
        self.config = config or CircuitBreakerConfig()
        self.state = CircuitState.CLOSED
        self.stats = CircuitBreakerStats()
        self._lock = threading.RLock()
        self._consecutive_successes = 0

    def call(self, func: Callable[..., Any], *args, **kwargs) -> Any:
        with self._lock:
            self.stats.total_calls += 1
            if self.state == CircuitState.OPEN:
                if self._should_attempt_reset():
                    self._set_state(CircuitState.HALF_OPEN)
                else:
                    raise CircuitBreakerOpenException(
                        f"Circuit breaker '{self.name}' is OPEN. "
                        f"Last failure: {self.stats.last_failure_time}"
                    )
            try:
                start = time.time()
                result = func(*args, **kwargs)
                elapsed = time.time() - start
                if elapsed > self.config.timeout:
                    raise TimeoutError(f"Call timed out after {elapsed:.2f}s")
                self._on_success()
                metrics.inc(f"{self.name}_success")
                metrics.add_latency(f"{self.name}_latency", elapsed)
                return result
            except self.config.expected_exception as e:
                self._on_failure()
                metrics.inc(f"{self.name}_failure")
                raise e
            except TimeoutError as e:
                self._on_timeout()
                metrics.inc(f"{self.name}_timeout")
                raise e
            except Exception as e:
                self._on_failure()
                metrics.inc(f"{self.name}_failure")
                raise e

    def _should_attempt_reset(self) -> bool:
        return (
            self.stats.last_failure_time is not None
            and time.time() - self.stats.last_failure_time >= self.config.recovery_timeout
        )

    def _on_success(self) -> None:
        self.stats.success_count += 1
        self.stats.successful_calls += 1
        self.stats.last_state_change = time.time()
        if self.state == CircuitState.HALF_OPEN:
            self._consecutive_successes += 1
            if self._consecutive_successes >= self.config.success_threshold:
                self._set_state(CircuitState.CLOSED)
                self._reset_counters()
        elif self.state == CircuitState.CLOSED:
            self.stats.failure_count = 0

    def _on_failure(self) -> None:
        self.stats.failure_count += 1
        self.stats.failed_calls += 1
        self.stats.last_failure_time = time.time()
        self.stats.last_state_change = time.time()
        if self.state == CircuitState.CLOSED:
            if self.stats.failure_count >= self.config.failure_threshold:
                self._set_state(CircuitState.OPEN)
        elif self.state == CircuitState.HALF_OPEN:
            self._set_state(CircuitState.OPEN)
            self._consecutive_successes = 0

    def _on_timeout(self) -> None:
        self._on_failure()
        self.stats.timeouts += 1

    def _set_state(self, state: CircuitState) -> None:
        old_state = self.state
        self.state = state
        self.stats.last_state_change = time.time()
        logging.info(
            f"Circuit breaker '{self.name}' changed state: "
            f"{old_state.value} -> {state.value}"
        )

    def _reset_counters(self) -> None:
        self.stats.failure_count = 0
        self.stats.success_count = 0
        self._consecutive_successes = 0

    def get_state(self) -> dict:
        with self._lock:
            return {
                "name": self.name,
                "state": self.state.value,
                "failure_count": self.stats.failure_count,
                "success_count": self.stats.success_count,
                "total_calls": self.stats.total_calls,
                "successful_calls": self.stats.successful_calls,
                "failed_calls": self.stats.failed_calls,
                "timeouts": self.stats.timeouts,
                "last_failure_time": self.stats.last_failure_time,
                "last_state_change": self.stats.last_state_change,
            }

    def reset(self) -> None:
        with self._lock:
            self._set_state(CircuitState.CLOSED)
            self._reset_counters()
            logging.info(f"Circuit breaker '{self.name}' manually reset")


