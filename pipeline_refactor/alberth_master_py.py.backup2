def get_memory_context(query: str) -> str:
    def _call():
        try:
            result = subprocess.run(
                ['python3', str(WORKSPACE_DIR / 'alberth_memory.py'), '--context', query],
                capture_output=True, text=True, timeout=5
            )
            if result.returncode == 0:
                ctx = result.stdout.strip()
                if ctx:
                    log_message(f"Memoria OK → Contexto recuperado ({len(ctx)} chars)")
                    return ctx
                log_message("Memoria: Sin contexto previo relevante (primera sesión o sin historial).")
            else:
                log_message("WARN: Falló la recuperación de contexto de memoria.", 'warn')
            return ""
        except Exception as e:
            log_message(f"ERROR al obtener contexto de memoria: {e}", 'error')
            return ""
    try:
        return HELPER_CB.call(_call)
    except Exception:
        return ""


def run_alberth_agent(message: str) -> Optional[str]:
    def _call():
        try:
            result = subprocess.run(
                ['openclaw', 'agent', '--agent', 'main', '--message', message, '--json'],
                capture_output=True, text=True, timeout=60
            )
            if result.returncode == 0 and result.stdout.strip():
                data = json.loads(result.stdout)
                resp = data.get('result', {}).get('payloads', [{}])[0].get('text', '').strip()
                resp = resp.replace('[assistant turn failed before producing content]', '').strip()
                if resp:
                    log_message(f"AGENT OK → Respuesta ({len(resp)} chars)")
                    return resp
                log_message("WARN: Respuesta vacía del agente. Usando fallback.", 'warn')
                raise RuntimeError("Agent returned empty response")
            else:
                log_message(f"ERROR: Falló conexión con el agente. Código: {result.returncode}", 'error')
                raise RuntimeError(f"Agent connection failed with code {result.returncode}")
        except subprocess.TimeoutExpired:
            log_message("ERROR: Timeout al ejecutar el agente.", 'error')
            raise TimeoutError("Agent timeout")
        except Exception as e:
            log_message(f"ERROR al ejecutar agente: {e}", 'error')
            raise
    try:
        return AGENT_CB.call(_call)
    except Exception:
        return "Señor, ocurrió un error inesperado. Por favor, intente de nuevo más tarde."


# ======================= TTS =======================
def run_tts_premium(text: str, output_file: Path) -> bool:
    def _call():
        try:
            result = subprocess.run(
                ['python3', str(WORKSPACE_DIR / 'alberth_tts_premium.py'), text, str(output_file)],
                capture_output=True, text=True, timeout=20
            )
            if result.returncode == 0 and output_file.exists():
                log_message(f"TTS PREMIUM OK → Audio: {output_file.name} (edge-tts)")
                return True
            raise RuntimeError("edge-tts failed")
        except Exception as e:
            log_message(f"ERROR en TTS Premium: {e}", 'error')
            raise
    try:
        return TTS_CB.call(_call)
    except Exception:
        return False


def run_tts_openclaw(text: str, output_file: Path) -> bool:
    def _call():
        try:
            result = subprocess.run(
                ['openclaw', 'infer', 'tts', 'convert', '--text', text, '--output', str(output_file)],
                capture_output=True, text=True, timeout=15
            )
            if result.returncode == 0 and output_file.exists():
                log_message(f"TTS OPENCLAW OK → Audio: {output_file.name}")
                return True
            raise RuntimeError("OpenClaw TTS failed")
        except Exception as e:
            log_message(f"ERROR en TTS OpenClaw: {e}", 'error')
            raise
    try:
        return TTS_CB.call(_call)
    except Exception:
        return False


def run_tts_fallback_say(text: str, output_file: Path) -> bool:
    try:
        result = subprocess.run(
            ['say', '-v', 'Mónica', '-o', str(output_file), '--', text],
            capture_output=True, text=True, timeout=10
        )
        if result.returncode == 0 and output_file.exists():
            log_message(f"TTS FALLBACK OK → Audio generado con 'say -v Mónica'")
            return True
        else:
            log_message("ERROR: Todos los métodos TTS fallaron.", 'error')
            return False
    except Exception as e:
        log_message(f"ERROR en TTS Fallback: {e}", 'error')
        return False


def play_audio(audio_file: Path) -> None:
    mute_signal = VOICE_DIR / '.alberth_speaking'
    try:
        mute_signal.touch()
        subprocess.run(['afplay', str(audio_file)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(0.5)  # Esperar para que el eco se disipe
    except Exception as e:
        log_message(f"Error al reproducir audio: {e}", 'error')
    finally:
        if mute_signal.exists():
            mute_signal.unlink(missing_ok=True)


# ======================= METRICS SERVER =======================
def start_metrics_server():
    """Start a simple HTTP server exposing /metrics in Prometheus format."""
    handler = http.server.SimpleHTTPRequestHandler
    # We'll override do_GET to serve only /metrics
    class MetricsHandler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path == '/metrics':
                self.send_response(200)
                self.send_header('Content-Type', 'text/plain; version=0.0.4')
                self.end_headers()
                metrics_data = metrics.to_prometheus()
                self.wfile.write(metrics_data.encode('utf-8'))
            else:
                self.send_response(404)
                self.end_headers()
                self.wfile.write(b'Not Found')
        def log_message(self, format, *args):
            # Suppress default log messages
            pass

    with socketserver.TCPServer(("", METRICS_PORT), MetricsHandler) as httpd:
        logging.info(f"Metrics server listening on port {METRICS_PORT}")
        httpd.serve_forever()


# ======================= MAIN PROCESSING =======================
def process_input(audio_file: Optional[Path] = None, text_only: bool = False, query_text: Optional[str] = None) -> None:
    """
    Función principal de procesamiento de entrada (audio o texto).
    """
    # Adquirir lock
    if not acquire_lock():
        log_message("No se pudo adquirir el lock. Abortando.", 'error')
        return

    try:
        base_name = None
        txt_file = None
        query = None

        if text_only:
            # Procesar entrada de texto directo
            base_name = f"web_text_{time.strftime('%Y%m%d_%H%M%S')}"
            txt_file = OUTPUT_DIR / f"{base_name}.txt"
            query = query_text.strip()
            if not query:
                log_message("Consulta de texto vacía. Abortando.", 'warn')
                return
            txt_file.write_text(query)
            log_message(f"--- PIPELINE INICIADO (TEXTO): {query} ---")
        else:
            # Procesar entrada de audio
            if not audio_file or not audio_file.exists():
                log_message("Archivo de audio no encontrado. Abortando.", 'error')
                return
            if audio_file.stat().st_size == 0:
                log_message("Archivo de audio vacío. Abortando.", 'error')
                return

            base_name = audio_file.stem
            txt_file = OUTPUT_DIR / f"{base_name}.txt"
            response_txt = OUTPUT_DIR / f"{base_name}_response.txt"
            response_mp3 = OUTPUT_DIR / f"{base_name}_response.mp3"

            log_message(f"--- PIPELINE INICIADO (AUDIO): {audio_file.name} ---")

            # PASO 1: STT — Transcripción de audio
            query = None
            # Intentar STT en la nube (Groq)
            query = run_stt_cloud(audio_file)
            if not query:
                # Fallback a STT local
                query = run_stt_local(audio_file)

            if not query:
                log_message("ERROR: No se pudo obtener transcripción por ningún método. Abortando.", 'error')
                return

            # Filtrar transcripciones de basura/silencio
            if filter_junk_transcription(query):
                log_message(f"FILTRO: Transcripción descartada por ser basura/silencio: '{query}'", 'warn')
                return

            log_message(f"FILTRO: Transcripción válida → '{query}'")
            txt_file.write_text(query)

            # Mover audio procesado
            processed_dir = INPUT_DIR / 'processed'
            processed_dir.mkdir(parents=True, exist_ok=True)
            processed_file = processed_dir / f"{base_name}.processed_{time.strftime('%Y%m%d_%H%M%S')}{audio_file.suffix}"
            try:
                audio_file.rename(processed_file)
            except Exception as e:
                log_message(f"Error al mover audio procesado: {e}", 'warn')

        # PASO 1.5: TÁLAMO — Pre-enrutamiento inteligente
        talamo_type, talamo_args = run_talo(query)
        is_talamo_routed = bool(talamo_type)

        # Preparar contextos
        memory_context = get_memory_context(query)
        visual_context = ""
        file_context = ""
        youtube_context = ""
        system_context = ""
        search_context = ""

        # Rutas especializadas basadas en Tálamo
        if talamo_type == "FINANCE_TICKER":
            finance_msg = run_finance_helper(talamo_args or {})
            if finance_msg:
                # Respuesta directa, pasar a TTS
                response_text = finance_msg
                # Generar audio y reproducir
                if response_text:
                    # TTS
                    audio_success = False
                    for tts_func in [run_tts_premium, run_tts_openclaw, run_tts_fallback_say]:
                        audio_file_path = OUTPUT_DIR / f"{base_name}_response.mp3"
                        if tts_func(response_text, audio_file_path):
                            audio_success = True
                            break
                    if audio_success:
                        play_audio(audio_file_path)
                    else:
                        log_message("ERROR: No se pudo generar audio para respuesta de finanzas.", 'error')
                # Guardar en memoria
                threading.Thread(target=lambda: subprocess.run(
                    ['python3', str(WORKSPACE_DIR / 'alberth_memory.py'), '--save', query, response_text],
                    capture_output=True
                ), daemon=True).start()
                log_message("--- PIPELINE COMPLETADO (FINANCE) ---")
                return

        elif talamo_type == "IMAGE_GEN":
            image_msg = run_image_helper(talamo_args or {})
            if image_msg:
                response_text = f"Señor, {image_msg}"
                # Generar audio y reproducir
                if response_text:
                    audio_success = False
                    for tts_func in [run_tts_premium, run_tts_openclaw, run_tts_fallback_say]:
                        audio_file_path = OUTPUT_DIR / f"{base_name}_response.mp3"
                        if tts_func(response_text, audio_file_path):
                            audio_success = True
                            break
                    if audio_success:
                        play_audio(audio_file_path)
                    else:
                        log_message("ERROR: No se pudo generar audio para respuesta de imagen.", 'error')
                # Guardar en memoria
                threading.Thread(target=lambda: subprocess.run(
                    ['python3', str(WORKSPACE_DIR / 'alberth_memory.py'), '--save', query, response_text],
                    capture_output=True
                ), daemon=True).start()
                log_message("--- PIPELINE COMPLETADO (IMAGE_GEN) ---")
                return

        elif talamo_type == "VISION_SCREEN":
            visual_context = run_vision_screen(talamo_args or {}, query) or ""

        elif talamo_type == "VISION_CAMERA":
            visual_context = run_vision_camera(talamo_args or {}) or ""

        elif talamo_type == "READ_PDF":
            file_context = run_pdf_helper(talamo_args or {}) or ""

        elif talamo_type == "YOUTUBE":
            youtube_context = run_youtube_helper(talamo_args or {}) or ""

        elif talamo_type in ["SYSTEM_UTILS", "REMINDER_TIMER"]:
            system_context = run_system_helper(talamo_args or {}) or ""

        elif talamo_type == "WEB_SEARCH":
            search_context = run_search_helper(talamo_args or {}) or ""

        # Construir mensaje para el agente
        agent_message = f"{memory_context}{visual_context}{file_context}{youtube_context}{system_context}{search_context}{query}"

        # PASO 2: Ejecutar agente Alberth
        response_text = run_alberth_agent(agent_message)

        # Guardar en memoria (asincrónico)
        threading.Thread(target=lambda: subprocess.run(
            ['python3', str(WORKSPACE_DIR / 'alberth_memory.py'), '--save', query, response_text],
            capture_output=True
        ), daemon=True).start()

        # PASO 3: TTS — Síntesis de voz
        audio_success = False
        audio_file_path = OUTPUT_DIR / f"{base_name}_response.mp3"
        for tts_func in [run_tts_premium, run_tts_openclaw, run_tts_fallback_say]:
            if tts_func(response_text, audio_file_path):
                audio_success = True
                break

        if not audio_success:
            log_message("ERROR: No se pudo generar audio para la respuesta.", 'error')
            # Aún así, continuamos para intentar reproducir si hay algún archivo parcial

        # PASO 4: REPRODUCCIÓN — Respuesta audible
        if audio_file_path.exists():
            play_audio(audio_file_path)

        # Si es modo texto, imprimir la respuesta en stdout para que el web server la capture
        if text_only:
            print(response_text)

        log_message("--- PIPELINE COMPLETADO ---")

    finally:
        # Siempre liberar el lock
        release_lock()


def main():
    """Función de entrada principal."""
    import argparse

    parser = argparse.ArgumentParser(description='Alberth Master - Pipeline de Voz')
    parser.add_argument('--file', type=str, help='Archivo de audio a procesar')
    parser.add_argument('--text', action='store_true', help='Modo texto (el siguiente argumento es la consulta)')
    parser.add_argument('--query', type=str, help='Texto de la consulta (usado con --text)')

    args = parser.parse_args()

    # Start metrics server in background thread
    metrics_thread = threading.Thread(target=start_metrics_server, daemon=True)
    metrics_thread.start()

    if args.text:
        if not args.query:
            print("Error: Se requiere --query cuando se usa --text")
            sys.exit(1)
        process_input(text_only=True, query_text=args.query)
    elif args.file:
        process_input(audio_file=Path(args.file))
    else:
        print("Error: Se requiere especificar --file o --text")
        sys.exit(1)


if __name__ == "__main__":
    # Signal handling for clean shutdown
    def _signal_handler(sig, frame):
        log_message("Recibida señal de terminación. Limpiando...", 'info')
        release_lock()
        sys.exit(0)

    signal.signal(signal.SIGINT, _signal_handler)
    signal.signal(signal.SIGTERM, _signal_handler)

    main()