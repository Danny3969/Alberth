                raise RuntimeError("Search helper failed")
            raise RuntimeError(f"Search helper failed with code {result.returncode}")
        except Exception as e:
            log_message(f"ERROR en Search Helper: {e}", 'error')
            raise
    try:
        return HELPER_CB.call(_call)
