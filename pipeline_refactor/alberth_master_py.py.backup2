# ======================= HELPERS =======================
def log_message(message: str, level: str = 'info') -> None:
    timestamp = time.strftime('%Y-%m-%d %H:%M:%S')
    log_line = f'[{timestamp}] {message}'
    if level == 'error':
        logger.error(message)
    elif level == 'warn':
        logger.warning(message)
    else:
        logger.info(message)
    with open(LOGFILE, 'a', encoding='utf-8') as f:
        f.write(log_line + '\n')


def acquire_lock(timeout: int = 30) -> bool:
    start = time.time()
    while time.time() - start < timeout:
        if not LOCK_FILE.exists():
            try:
                LOCK_FILE.write_text(str(os.getpid()))
                return True
            except Exception as e:
                log_message(f"Error al crear lock file: {e}", 'error')
                return False
        else:
            try:
                pid = int(LOCK_FILE.read_text().strip())
                os.kill(pid, 0)
                time.sleep(0.5)
            except (ValueError, ProcessLookupError):
                log_message("Eliminando lock file huérfano", 'warn')
                LOCK_FILE.unlink(missing_ok=True)
            except Exception as e:
                log_message(f"Error al verificar lock: {e}", 'error')
                time.sleep(0.5)
    log_message(f"Timeout al adquirir lock después de {timeout} segundos", 'warn')
    return False


def release_lock() -> None:
    try:
        if LOCK_FILE.exists():
            LOCK_FILE.unlink()
    except Exception as e:
        log_message(f"Error al liberar lock: {e}", 'error')


# ======================= SERVICE CALLS =======================
def run_stt_cloud(audio_file: Path) -> Optional[str]:
    def _call():
        try:
            cmd = [
                'openclaw', 'infer', 'audio', 'transcribe',
                '--file', str(audio_file),
                '--model', 'groq/whisper-large-v3-turbo',
                '--json'
            ]
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=25)
            if result.returncode == 0 and result.stdout.strip():
                data = json.loads(result.stdout)
                query = data.get('result', {}).get('outputs', [{}])[0].get('text', '').strip()
                if query:
                    log_message(f"STT CLOUD OK → Transcripción: {query}")
                    return query
            raise RuntimeError("STT cloud failed or empty")
        except subprocess.TimeoutExpired:
            raise TimeoutError("STT cloud timeout")
        except Exception as e:
            log_message(f"ERROR en STT Cloud: {e}", 'error')
            raise
    try:
        return STT_CLOUD_CB.call(_call)
    except Exception:
        return None


def run_stt_local(audio_file: Path) -> Optional[str]:
    def _call():
        try:
            whisper_out_dir = Path(f"/tmp/alberth_whisper_{os.getpid()}")
            whisper_out_dir.mkdir(parents=True, exist_ok=True)
            cmd = [
                'whisper',
                str(audio_file),
                '--model', 'base',
                '--language', 'es',
                '--output_format', 'txt',
                '--output_dir', str(whisper_out_dir),
                '--fp16', 'False'
            ]
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
            if result.returncode == 0:
                txts = list(whisper_out_dir.glob('*.txt'))
                if txts:
                    query = txts[0].read_text().strip()
                    if query:
                        log_message(f"STT LOCAL OK → Transcripción: {query}")
                        return query
            raise RuntimeError("STT local failed")
        except subprocess.TimeoutExpired:
            raise TimeoutError("STT local timeout")
        except Exception as e:
            log_message(f"ERROR en STT Local: {e}", 'error')
            raise
        finally:
            import shutil
            shutil.rmtree(whisper_out_dir, ignore_errors=True)
    try:
        return STT_LOCAL_CB.call(_call)
    except Exception:
        return None


def filter_junk_transcription(query: str) -> bool:
    if not query or len(query.strip()) < 4:
        return True
    ql = query.strip().lower()
    junk = {
        "thank you", "thanks", "thank you.", "thanks.", ".", "..", "...", "!",
        "ok", "okay", "um", "uh", "hmm", "mm", "bye", "bye.", "you", "the", "a",
        "si", "sí", "no", "yes", "yes.", "yeah", "yeah.", "yep", "nope", "sure",
        "right", "this is the video", "this is the video.", "subtítulos realizados por la comunidad de amara.org",
        "subtitulos en español", "suscríbete", "suscribete", "music", "music.", "applause", "laughter"
    }
    return ql in junk


def check_wake_word(query: str, wake_word_enabled: bool) -> Tuple[bool, str]:
    if not wake_word_enabled:
        return True, query
    ww_mode_file = WORKSPACE_DIR / '.wakeword_mode'
    if ww_mode_file.exists() and ww_mode_file.read_text().strip() == 'true':
        session_file = Path("/tmp/alberth_session_active")
        session_active = False
        session_timeout = 45
        if session_file.exists():
            try:
                now = time.time()
                last_active = os.path.getmtime(str(session_file))
                if (now - last_active) < session_timeout:
                    session_active = True
                    log_message(f"Sesión de voz activa (última actividad hace {int(now - last_active)}s).")
            except Exception as e:
                log_message(f"Error al verificar sesión: {e}", 'error')
        ql = query.lower()
        wake = ['alberth', 'alberto', 'albert', 'oye alberth', 'hey alberth']
        if any(w in ql for w in wake) or session_active:
            try:
                session_file.touch()
            except Exception:
                pass
            import re
            pattern = re.compile(r'^(alberth|alberto|albert|oye alberth|hey alberth)[, ]*', re.IGNORECASE)
            proc = pattern.sub('', query).strip()
            log_message(f"Wake Word detectado. Query procesada: '{proc}'")
            return True, proc
        else:
            log_message("Ignorando audio: Wake word no detectado y sesión inactiva.", 'warn')
            return False, query
    else:
        try:
            Path("/tmp/alberth_session_active").touch()
        except Exception:
            pass
        return True, query


def run_talo(query: str) -> tuple[Optional[str], Optional[Dict]]:
    def _call():
        try:
            result = subprocess.run(
                ['python3', str(WORKSPACE_DIR / 'alberth_talamo.py'), query],
                capture_output=True, text=True, timeout=10
            )
            if result.returncode == 0 and result.stdout.strip():
                data = json.loads(result.stdout)
                tt = data.get('tipo_tarea', 'GENERAL_TALK')
                args = data.get('argumentos', {})
                log_message(f"Tálamo → Tipo: {tt}")
                return tt, args
            raise RuntimeError("Tálamo returned empty")
        except subprocess.TimeoutExpired:
            raise TimeoutError("Tálamo timeout")
        except Exception as e:
            log_message(f"ERROR en Tálamo: {e}", 'error')
            raise
    try:
        return HELPER_CB.call(_call)
    except Exception:
        return None, None


