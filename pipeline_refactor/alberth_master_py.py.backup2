def run_vision_screen(args: Dict, query: str) -> Optional[str]:
    def _call():
        try:
            ql = query.lower()
            # DIFF
            if any(p in ql for p in ['qué cambió', 'que cambio', 'cambió algo', 'cambio algo', 'qué pasó', 'que paso', 'hay algo nuevo', 'algo nuevo']):
                diff = 8
                result = subprocess.run(
                    ['python3', str(WORKSPACE_DIR / 'alberth_screen_copilot.py'), '--diff', str(diff)],
                    capture_output=True, text=True, timeout=10
                )
                if result.returncode == 0 and result.stdout.strip():
                    desc = result.stdout.strip()
                    log_message("Análisis DIFF completado.")
                    return f"[ANÁLISIS DIFERENCIAL DE PANTALLA: Comparaste dos capturas separadas por {diff} segundos. {diff} segundos. Descripción de los cambios detectados: {desc}]"
                raise RuntimeError("Vision screen diff failed")
            # COPILOTO CONTINUO
            elif any(p in ql for p in ['activa el copiloto', 'inicia el copiloto', 'coploto de pantalla', 'empieza a monitorear', 'monitorea mi pantalla', 'modo copiloto']):
                watch = 30
                import re
                m = re.search(r'cada (\d+) seg', ql)
                if m:
                    watch = int(m.group(1))
                subprocess.Popen(
                    ['python3', str(WORKSPACE_DIR / 'alberth_screen_copilot.py'), '--watch', str(watch)],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                )
                return f"[SISTEMA: Se ha activado el Copiloto de Pantalla en modo daemon. Alberth ahora analizará tu pantalla automáticamente cada {watch} segundos. Los análisis quedarán guardados en voice_exchange/copilot_latest.txt. Para detenerlo, dile: 'desactiva el copiloto'.]"
            # DETENER COPILOTO
            elif any(p in ql for p in ['desactiva el copiloto', 'detén el copiloto', 'detén el monitoreo', 'para el copiloto', 'stop copiloto']):
                subprocess.run(
                    ['python3', str(WORKSPACE_DIR / 'alberth_screen_copilot.py'), '--stop'],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                )
                return "[SISTEMA: El Copiloto de Pantalla ha sido desactivado correctamente.]"
            # SNAPSHOT
            else:
                result = subprocess.run(
                    ['python3', str(WORKSPACE_DIR / 'alberth_screen_copilot.py'), query],
                    capture_output=True, text=True, timeout=10
                )
                if result.returncode == 0 and result.stdout.strip():
                    desc = result.stdout.strip()
                    log_message("Análisis de pantalla completado con éxito.")
                    return f"[CONTEXTO DE PANTALLA: El usuario te ha pedido que analices su pantalla de trabajo. La herramienta de visión describe lo siguiente: {desc}]"
                raise RuntimeError("Vision screen snapshot failed")
        except Exception as e:
            log_message(f"ERROR en Vision Screen Helper: {e}", 'error')
            raise
    try:
        return HELPER_CB.call(_call)
    except Exception:
        return None


